<odoo>
    <record id="module_category_car_rental" model="ir.module.category">
        <field name="name">Car Rental</field>
    </record>

    <record id="group_rental_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_car_rental" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_car_rental" />
        <field name="implied_ids" eval="[(4, ref('group_rental_agent'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="rental_rule_agent_own" model="ir.rule">
        <field name="name">Rental: agents see their own rentals</field>
        <field name="model_id" ref="model_rental_rental" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rental_agent'))]" />
    </record>

    <record id="rental_rule_manager_all" model="ir.rule">
        <field name="name">Rental: Manager see all rentals</field>
        <field name="model_id" ref="model_rental_rental" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rental_manager'))]" />
    </record>
</odoo>