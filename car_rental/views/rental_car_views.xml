<odoo>
  <!-- 1. VUE LISTE -->
  <record id="rental_car_view_list" model="ir.ui.view">
    <field name="name">rental.car.list</field>
    <field name="model">rental.car</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="license_plate" />
        <field name="brand" />
        <field name="model_name" optional="hide" />
        <field name="year" optional="hide" />
        <field name="currency_id" optional="hide" />
        <field name="daily_price" />
        <field name="state" />
      </list>
    </field>
  </record>

  <!-- 2. VUE FORMULAIRE -->
  <record id="rental_car_view_form" model="ir.ui.view">
    <field name="name">rental.car.form</field>
    <field name="model">rental.car</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <field name="image"
            widget="image"
            class="oe_avatar" />
          <group>
            <group>
              <field name="name" />
              <field name="license_plate" />
              <field name="brand" />
              <field name="model_name" />
            </group>
            <group>
              <field name="year" />
              <field name="daily_price" />
              <field name="currency_id" />
              <field name="state" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- 3. ACTION -->
  <record id="rental_car_action" model="ir.actions.act_window">
    <field name="name">Cars</field>
    <field name="res_model">rental.car</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- 4. MENUS -->
  <menuitem id="rental_menu_root" name="Car Rental"
    web_icon="car_rental,static/description/icon.png" />
  <menuitem
    id="rental_menu_cars"
    name="Cars"
    parent="rental_menu_root"
    action="rental_car_action"
    sequence="20"
  />
</odoo>