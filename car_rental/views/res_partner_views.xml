<odoo>
    <record id="res_partner_view_form_inherit_rental" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rentals" type="object"
                    class="oe_stat_button" icon="fa-car">
                    <field name="rental_count" widget="statinfo" string="Rentals" />
                </button>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="driving_license" />
            </xpath>

        </field>
    </record>
</odoo>