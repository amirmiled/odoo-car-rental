<odoo>
    <record id="ir_cron_rental_late" model="ir.cron">
        <field name="name">Car Rental: Check late rentals</field>
        <field name="model_id" ref="model_rental_rental" />
        <field name="state">code</field>
        <field name="code">model._cron_check_late_rentals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>